# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MOBILE_STUDIO_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
# Bind privately; place behind an authenticated HTTPS tunnel if needed from ReplyHalo.
MOBILE_STUDIO_HOST=127.0.0.1
MOBILE_STUDIO_PORT=8788
MOBILE_STUDIO_WORKSPACE_ID=REPLACE_WITH_YOUR_REPLYHALO_WORKSPACE_ID
MOBILE_STUDIO_CONTENT_DIR=/srv/replyhalo-content/Content
MOBILE_STUDIO_RUNS_DB=/srv/replyhalo-content/runs.sqlite3
MOBILE_STUDIO_CONTAINER=replyhalo-mobile-android
MOBILE_STUDIO_ADB_SERIAL=emulator-5554
